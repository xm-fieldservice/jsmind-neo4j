# Quivr服务环境变量配置示例
# 复制此文件为 .env 并填入真实的API Key

# 通义千问API Key（推荐）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# DeepSeek API Key（备选）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Moonshot API Key（备选）
MOONSHOT_API_KEY=sk-your-moonshot-api-key-here

# 服务配置
QUIVR_API_HOST=0.0.0.0
QUIVR_API_PORT=8000

# 日志级别
LOG_LEVEL=INFO

# 超时设置（秒）
OPENAI_TIMEOUT=60
