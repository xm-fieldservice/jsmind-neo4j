# Neo4j + D3.js 集成配置文件
# 请根据您的Neo4j安装情况修改以下配置

# Neo4j数据库连接配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# 如果您使用Neo4j Desktop，通常配置如下：
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=您设置的密码

# 如果您使用Neo4j Aura云服务，配置如下：
# NEO4J_URI=neo4j+s://您的实例地址
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=您的密码

# 服务器配置
BACKEND_HOST=localhost
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 调试模式
DEBUG=true
