            });
            
            // 仓库按钮 - 打开工作栏仓库管理界面
            document.getElementById('open-warehouse-btn')?.addEventListener('click', function() {
                console.log('[仓库] 打开仓库管理界面');
                if (window.ColumnWarehouseUI) {
                    window.ColumnWarehouseUI.show();
                } else {
                    alert('  仓库UI未初始化，请稍后再试');
                }
            });
        });
    </script>
    
    <!-- 本地后端 API 基址配置（必须在注册管理器之前设置） -->
    <script>
      // 如需更换端口，请修改此处端口号
      window.__REGISTRY_API_BASE = window.__REGISTRY_API_BASE || 'http://127.0.0.1:8081';
      // 简易连通性检测
      (function(){
        try{
          fetch(window.__REGISTRY_API_BASE + '/health', { method:'GET' })
            .then(r=>r.ok?r.json():Promise.reject(new Error('HTTP '+r.status)))
            .then(()=>{ window.LogPanel && window.LogPanel.log('后端健康检查通过'); })
            .catch((err)=>{ window.LogPanel && window.LogPanel.warn('后端健康检查失败：' + (err&&err.message?err.message:String(err))); });
        }catch(_){ /* ignore */ }
      })();
    </script>
    
