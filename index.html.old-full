    <script>
      // 简化配置：只保留必要的设置
      console.log('[系统] 使用简化持久化服务');
      
      // 统一脚本加载器 - 消除重复的load函数
      window.loadScript = function(src, cb) {
        var s = document.createElement('script');
        s.src = src;
        s.defer = true;
        s.onload = function() { cb && cb(); };
        s.onerror = function() { cb && cb(new Error('fail ' + src)); };
        document.head.appendChild(s);
      };
    </script>
    <!-- 关系管理样式 -->
    <link rel="stylesheet" href="relation_styles.css">
