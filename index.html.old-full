    <!-- 笔记栏功能（已禁用 - DOM元素已删除） -->\r\n    <!-- <script>
        // 笔记栏功能
        window.addEventListener('DOMContentLoaded', function() {
            let notes = JSON.parse(localStorage.getItem('notes_data') || '[]');
            let selectedAgent = null;
            
            function renderNotes() {
                const display = document.getElementById('notes-display');
                const count = document.querySelector('.notes-count');
                
                if (notes.length === 0) {
                    display.innerHTML = '<div class="notes-empty">暂无笔记，在下方输入框中添加笔记</div>';
                } else {
                    display.innerHTML = notes.map(note => `
                        <div class="notes-item">
                            <div class="notes-item-time">${new Date(note.time).toLocaleString()}</div>
                            <div class="notes-item-content">${note.content}</div>
                            ${note.type ? `<div class="notes-item-type">[${note.type}]</div>` : ''}
                        </div>
                    `).join('');
                }
                
                count.textContent = `${notes.length} 条笔记`;
            }
            
            function saveNotes() {
                localStorage.setItem('notes_data', JSON.stringify(notes));
            }
            
            function addNote(content, type = 'note') {
                notes.unshift({
                    id: Date.now(),
                    content: content,
                    time: Date.now(),
                    type: type
                });
                renderNotes();
                saveNotes();
            }
            
            function updateAgentStatus(status, text) {
                const statusEl = document.getElementById('agent-status');
                statusEl.className = `agent-status ${status}`;
                statusEl.textContent = text;
            }
            
            // Agent API调用函数 - 调用外部脚本，不使用自定义运行机制
            async function callAgentAPI(agent, userInput) {
                try {
                    // 调用后端API，后端会使用外部脚本运行
                    const response = await fetch('http://127.0.0.1:8081/api/agent/run', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            agent_config: agent.data,
                            user_input: userInput,
                            agent_type: detectAgentType(agent.data)
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        return {
                            success: true,
                            result: result.response || result.output || '智能体响应为空'
                        };
                    } else {
                        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                    }
                    
                } catch (networkError) {
                    // 网络错误时，尝试使用Python脚本作为备选方案
                    console.warn('后端API不可用，尝试备选方案:', networkError.message);
                    
                    try {
                        // 返回指导信息
                        return {
                            success: false,
                            message: `后端API不可用，请检查：
1.  服务器是否正在运行
2. 环境变量已正确配置
3. AutoGen模块已安装`,
                            error: networkError.message
                        };
                        
                    } catch (fallbackError) {
                        return {
                            success: false,
                            error: `Agent调用失败: ${networkError.message}`
                        };
                    }
                }
            }
            
            // 检测Agent类型
            function detectAgentType(agentData) {
                if (!agentData) return 'agent';
                
                // 检测Team特征
                if (agentData.members || agentData.participants) {
                    return 'team';
                }
                
                if (agentData.config) {
                    if (agentData.config.participants || agentData.config.members) {
                        return 'team';
                    }
                }
                
                // 默认为agent
                return 'agent';
            }
            
            // 智能体选择
            document.getElementById('agent-select-btn')?.addEventListener('click', function() {
                document.getElementById('fileInputAgent').click();
            });
            
            // 文件选择处理
            document.getElementById('fileInputAgent')?.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        try {
                            const agentData = JSON.parse(event.target.result);
                            selectedAgent = {
                                name: file.name,
                                path: file.name,
                                data: agentData
                            };
                            updateAgentStatus('selected', `已选择: ${file.name}`);
                            addNote(`智能体已选择: ${file.name}`, 'system');
                        } catch (error) {
                            alert('智能体文件格式错误: ' + error.message);
                            updateAgentStatus('', '选择失败');
                        }
                    };
                    reader.readAsText(file);
                }
            });
            
            // 发送给智能体
            document.getElementById('notes-send-btn')?.addEventListener('click', async function() {
                const input = document.getElementById('notes-input-text');
                const content = input.value.trim();
                
                if (!selectedAgent) {
                    alert('请先选择一个智能体');
                    return;
                }
                
                if (!content) {
                    alert('请输入要发送给智能体的内容');
                    return;
                }
                
                // 添加用户输入到笔记
                addNote(`[用户] ${content}`, 'user');
                
                // 开始处理
                updateAgentStatus('processing', '处理中...');
                
                try {
                    // 调用后端API运行Agent
                    const response = await callAgentAPI(selectedAgent, content);
                    
                    if (response.success) {
                        addNote(`[${selectedAgent.name}] ${response.result}`, 'agent');
                        updateAgentStatus('selected', `已选择: ${selectedAgent.name}`);
                    } else {
                        addNote(`[错误] ${response.error}`, 'system');
                        updateAgentStatus('selected', `已选择: ${selectedAgent.name} (上次调用失败)`);
                    }
                    
                    input.value = '';
                    
                } catch (error) {
                    addNote(`[系统错误] Agent调用失败: ${error.message}`, 'system');
                    updateAgentStatus('selected', `已选择: ${selectedAgent.name} (连接失败)`);
                }
            });
            
            // 添加笔记
            document.getElementById('notes-add-btn')?.addEventListener('click', function() {
                const input = document.getElementById('notes-input-text');
                const content = input.value.trim();
                
                if (content) {
                    addNote(content, 'note');
                    input.value = '';
                }
            });
            
            // 清空输入
            document.getElementById('notes-clear-input-btn')?.addEventListener('click', function() {
                document.getElementById('notes-input-text').value = '';
            });
            
            // 清空所有笔记
            document.getElementById('notes-clear-btn')?.addEventListener('click', function() {
                if (confirm('确定要清空所有笔记吗？')) {
                    notes = [];
                    renderNotes();
                    saveNotes();
                }
            });
            
            // 保存笔记
            document.getElementById('notes-save-btn')?.addEventListener('click', function() {
                saveNotes();
                alert('笔记已保存');
            });
            
            // 回车发送给智能体
            document.getElementById('notes-input-text')?.addEventListener('keypress', function(e) {
                if (e.key === 'Enter' && e.ctrlKey) {
                    if (selectedAgent) {
                        document.getElementById('notes-send-btn').click();
                    } else {
                        document.getElementById('notes-add-btn').click();
                    }
                }
            });
            
            // 初始化显示
            renderNotes();\r\n        });\r\n    </script> -->\r\n    \r\n    <!-- 工作区功能 -->
    <script>
        // 工作区功能（已简化）
        window.addEventListener('DOMContentLoaded', function() {
            // 工作区刷新按钮 - 仅保留基本功能
            document.getElementById('workspace-refresh-btn')?.addEventListener('click', function() {
                console.log('[工作区] 刷新按钮被点击');
