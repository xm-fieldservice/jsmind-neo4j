    <script src="https://d3js.org/d3.v7.min.js"></script>
    
    <!-- jsMind 样式与脚本（本地优先，CDN 兜底） -->
    <link rel="stylesheet" href="vendor/jsmind/style/jsmind.css" onerror="this.onerror=null;this.href='https://cdn.jsdelivr.net/npm/jsmind/style/jsmind.css'">
    <script>
      (function(){
        var local = ['vendor/jsmind/js/jsmind.js','vendor/jsmind/js/jsmind.draggable-node.js'];
        var cdn   = ['https://unpkg.com/jsmind@0.8.7/es6/jsmind.js','https://unpkg.com/jsmind@0.8.7/es6/jsmind.draggable-node.js'];
        var i=0; (function next(){ if(i>=local.length){
            // 运行时校验 jsMind 是否可用，否则回退到 CDN
            if (typeof window.jsMind === 'undefined'){ window.loadScript(cdn[0], function(){ if (typeof window.jsMind==='undefined'){ console.error('jsMind 加载失败'); } }); }
            return;
          }
          window.loadScript(local[i], function(err){ if(err){ window.loadScript(cdn[i], function(){ i++; next(); }); } else { i++; next(); } });
        })();
      })();
    </script>
    <!-- 启用原生拖拽功能 -->
    <script>
      (function(){
        function whenReady(cb){ if (window.jsMind) { cb(); } else { setTimeout(function(){ whenReady(cb); }, 50); } }
        whenReady(function(){
          console.log('[init] jsMind 原生拖拽功能已启用');
        });
      })();
    </script>
    <!-- Markdown 渲染与样式（本地优先，CDN 兜底） -->
    <script>
      (function(){
        // 先尝试本地，再检测 window.marked，不存在则兜底到 CDN
        window.loadScript('vendor/marked/marked.min.js', function(){
          if (typeof window.marked === 'undefined'){
            window.loadScript('https://cdn.jsdelivr.net/npm/marked/marked.min.js');
          }
        });
      })();
    </script>
    <link rel="stylesheet" href="vendor/github-markdown/github-markdown.min.css" onerror="this.onerror=null;this.href='https://cdn.jsdelivr.net/npm/github-markdown-css@5.2.0/github-markdown.min.css'">
