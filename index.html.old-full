    <!-- 简易状态脚本：查询 IndexedDB 计数并弹窗显示 -->
    <script>
      (function(){
        const btn = document.getElementById('mindmap-idb-status-btn');
        if (btn){
          btn.addEventListener('click', async ()=>{
            try{
              if (!window.MindmapStorage || typeof window.MindmapStorage.getStatus !== 'function'){
                alert('本地内容库适配器未加载或不支持 getStatus');
                return;
              }
              const s = await window.MindmapStorage.getStatus();
              alert(`IndexedDB 状态\nNodes: ${s.nodes}\nContents: ${s.contents}\nVersions: ${s.versions}`);
            }catch(e){
              alert('查询失败：' + (e && e.message ? e.message : String(e)));
            }
          });
        }
      })();
    </script>
    
