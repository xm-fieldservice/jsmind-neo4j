{"content":"# 脑图项目：笔记页面\n\n## 项目信息\n- **项目ID**: root-1758268230907-7vq1\n- **最后更新**: 2025/9/19 17:28:48\n- **数据格式**: node_tree\n\n## 脑图数据\n```json\n{\n  \"id\": \"root-1758268230907-7vq1\",\n  \"topic\": \"笔记页面\",\n  \"expanded\": true,\n  \"content\": \"作为标准组件的开发标准\\n\",\n  \"data\": {\n    \"content\": \"作为标准组件的开发标准\\n\"\n  },\n  \"background-color\": \"#f5f5f5\",\n  \"foreground-color\": \"#333\",\n  \"children\": [\n    {\n      \"id\": \"n3\",\n      \"topic\": \"输入框\",\n      \"expanded\": true,\n      \"direction\": \"right\",\n      \"content\": \"开发计划...\",\n      \"data\": {\n        \"content\": \"开发计划...\"\n      },\n      \"background-color\": \"#f5f5f5\",\n      \"foreground-color\": \"#333\",\n      \"children\": [\n        {\n          \"id\": \"96148c927773fa60\",\n          \"topic\": \"回车发送\",\n          \"expanded\": true,\n          \"content\": \"创建: 2025-09-19 17:23:18\\n\\n\",\n          \"data\": {\n            \"content\": \"创建: 2025-09-19 17:23:18\\n\\n\"\n          },\n          \"background-color\": \"#f5f5f5\",\n          \"foreground-color\": \"#333\"\n        },\n        {\n          \"id\": \"node-1758273940397-irt0\",\n          \"topic\": \"alt + 回车发送给智能体\",\n          \"expanded\": true,\n          \"content\": \"创建: 2025-09-19 17:25:40\\n\\n\",\n          \"data\": {\n            \"content\": \"创建: 2025-09-19 17:25:40\\n\\n\"\n          },\n          \"background-color\": \"#f5f5f5\",\n          \"foreground-color\": \"#333\"\n        },\n        {\n          \"id\": \"9614be1d3b1d0ab4\",\n          \"topic\": \"shift + 回车：直接记入笔记\",\n          \"expanded\": true,\n          \"content\": \"创建: 2025-09-19 17:26:46\\n\\n\",\n          \"data\": {\n            \"content\": \"创建: 2025-09-19 17:26:46\\n\\n\"\n          },\n          \"background-color\": \"#f5f5f5\",\n          \"foreground-color\": \"#333\"\n        }\n      ]\n    },\n    {\n      \"id\": \"9614cc3bbbce331a\",\n      \"topic\": \"输入按键\",\n      \"expanded\": true,\n      \"direction\": \"right\",\n      \"content\": \"创建: 2025-09-19 17:27:43\\n\\n\",\n      \"children\": [\n        {\n          \"id\": \"9614ce737e91a66a\",\n          \"topic\": \"添加附件\",\n          \"expanded\": true,\n          \"content\": \"创建: 2025-09-19 17:27:42\\n\\n\",\n          \"data\": {\n            \"content\": \"创建: 2025-09-19 17:27:42\\n\\n\"\n          }\n        }\n      ],\n      \"data\": {\n        \"content\": \"创建: 2025-09-19 17:27:43\\n\\n\"\n      }\n    },\n    {\n      \"id\": \"961490aa0661846b\",\n      \"topic\": \"输出框\",\n      \"expanded\": true,\n      \"direction\": \"right\",\n      \"content\": \"创建: 2025-09-19 17:23:34\\n\\n\",\n      \"data\": {\n        \"content\": \"创建: 2025-09-19 17:23:34\\n\\n\"\n      },\n      \"background-color\": \"#f5f5f5\",\n      \"foreground-color\": \"#333\",\n      \"children\": [\n        {\n          \"id\": \"9614d2d9126e6e8e\",\n          \"topic\": \"MD阅读器\",\n          \"expanded\": true,\n          \"content\": \"创建: 2025-09-19 17:28:48\\n\\n\",\n          \"data\": {\n            \"content\": \"创建: 2025-09-19 17:28:48\\n\\n\"\n          }\n        },\n        {\n          \"id\": \"9614d4d4d4cb8910\",\n          \"topic\": \"笔记内容标题栏右侧（添加”复制“按键\",\n          \"expanded\": true,\n          \"content\": \"创建: 2025-09-19 17:28:27\\n全部复制输出框内的内容到剪贴板\\n\",\n          \"data\": {\n            \"content\": \"创建: 2025-09-19 17:28:27\\n全部复制输出框内的内容到剪贴板\\n\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"961496e1a6786f4e\",\n      \"topic\": \"智能体\",\n      \"expanded\": true,\n      \"direction\": \"right\",\n      \"content\": \"创建: 2025-09-19 17:23:50\\n\\n\",\n      \"data\": {\n        \"content\": \"创建: 2025-09-19 17:23:50\\n\\n\"\n      },\n      \"background-color\": \"#f5f5f5\",\n      \"foreground-color\": \"#333\",\n      \"children\": [\n        {\n          \"id\": \"node-1758273834249-2m7v\",\n          \"topic\": \"通用脚本\",\n          \"expanded\": true,\n          \"content\": \"设计说是的，这个脚本已经完全兼容Agent和Team！\\n\\n✅ 自动识别: 根据component_type字段自动识别\\n✅ 统一接口: 相同的命令行参数和API接口\\n✅ 原生支持: 严格使用AutoGen 0.7.1原生方法\\n✅ 测试验证: Agent和Team都测试成功\\n✅ 笔记栏集成: 后端API透明支持两种类型\\n一个脚本，两种模式，完全兼容！🚀明...\\n\\n---\\n\\n### 通用脚本\\n2025-09-19 17:21:00\\n\\n# -*- coding: utf-8 -*-\\n\\\"\\\"\\\"\\n通用智能体运行脚本 - 严格遵循AutoGen 0.7.1本地知识库规范\\n支持Agent和Team配置\\n参照: autogen_repo/python/samples/agentchat_chainlit/app_team.py\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport json\\nimport os\\nimport sys\\nimport traceback\\nimport io\\nimport asyncio\\nfrom pathlib import Path\\nfrom typing import Dict, Any, Optional, List\\n\\n# 设置UTF-8输出\\nsys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')\\n\\n# 项目根目录\\nROOT = Path(__file__).resolve().parent\\nif str(ROOT) not in sys.path:\\n    sys.path.insert(0, str(ROOT))\\n\\n# 自动加载.env文件\\ndef load_env_file():\\n    env_file = ROOT / \\\".env\\\"\\n    if env_file.exists():\\n        try:\\n            with open(env_file, 'r', encoding='utf-8') as f:\\n                for line in f:\\n                    line = line.strip()\\n                    if line and not line.startswith('#') and '=' in line:\\n                        key, value = line.split('=', 1)\\n                        key = key.strip()\\n                        value = value.strip().strip('\\\"').strip(\\\"'\\\")\\n                        if key and not os.environ.get(key):\\n                            os.environ[key] = value\\n        except Exception as e:\\n            print(f\\\"[警告] .env文件加载失败: {e}\\\")\\n\\n# 加载环境变量\\nload_env_file()\\n\\n# 导入AutoGen 0.7.1原生模块 - 严格按照本地知识库规范\\ntry:\\n    from autogen_agentchat.agents import AssistantAgent\\n    from autogen_agentchat.teams import RoundRobinGroupChat\\n    from autogen_agentchat.ui import Console\\n    from autogen_agentchat.messages import TextMessage\\n    from autogen_ext.models.openai import OpenAIChatCompletionClient\\n    print(\\\"[导入] 使用AutoGen 0.7.1原生模块\\\")\\nexcept ImportError as e:\\n    print(f\\\"错误: 无法导入AutoGen原生模块: {e}\\\")\\n    print(\\\"请确保已安装AutoGen 0.7.1:\\\")\\n    print(\\\"  pip install autogen-agentchat autogen-ext\\\")\\n    sys.exit(1)\\n\\nclass UniversalRunner:\\n    \\\"\\\"\\\"通用运行器 - 支持Agent和Team - 严格遵循本地知识库规范\\\"\\\"\\\"\\n    \\n    def __init__(self, config_path: str, verbose: bool = False):\\n        self.config_path = Path(config_path)\\n        self.verbose = verbose\\n        self.config = None\\n        self.component_type = None\\n        self.agent = None\\n        self.team = None\\n        self.clients = []  # 存储所有model clients用于清理\\n        \\n        self._load_config()\\n        self._create_component()\\n    \\n    def _load_config(self):\\n        \\\"\\\"\\\"加载配置文件\\\"\\\"\\\"\\n        if not self.config_path.exists():\\n            raise FileNotFoundError(f\\\"配置文件不存在: {self.config_path}\\\")\\n        \\n        try:\\n            with self.config_path.open('r', encoding='utf-8') as f:\\n                self.config = json.load(f)\\n            \\n            self.component_type = self.config.get('component_type', 'agent')\\n            \\n            if self.verbose:\\n                print(f\\\"[配置] 已加载: {self.config_path}\\\")\\n                print(f\\\"[配置] 组件类型: {self.component_type}\\\")\\n                \\n        except Exception as e:\\n            raise ValueError(f\\\"配置文件格式错误: {e}\\\")\\n    \\n    def _create_model_client(self, model_config: Dict[str, Any]) -> OpenAIChatCompletionClient:\\n        \\\"\\\"\\\"创建模型客户端 - 严格按照本地知识库规范\\\"\\\"\\\"\\n        mc_config = model_config.get('config', {})\\n        \\n        model = mc_config.get('model', 'gpt-3.5-turbo')\\n        base_url = mc_config.get('base_url')\\n        api_key_env = mc_config.get('api_key_env', 'OPENAI_API_KEY')\\n        \\n        # 获取API密钥\\n        api_key = os.getenv(api_key_env)\\n        if not api_key:\\n            raise ValueError(f\\\"环境变量 {api_key_env} 未设置\\\")\\n        \\n        if self.verbose:\\n            print(f\\\"[模型] 模型: {model}\\\")\\n            print(f\\\"[模型] API地址: {base_url}\\\")\\n            print(f\\\"[模型] API密钥环境变量: {api_key_env}\\\")\\n        \\n        # 构建客户端参数\\n        client_params = {\\n            'model': model,\\n            'api_key': api_key\\n        }\\n        \\n        if base_url:\\n            client_params['base_url'] = base_url\\n        \\n        # 添加其他配置参数\\n        for key, value in mc_config.items():\\n            if key not in ['model', 'base_url', 'api_key', 'api_key_env']:\\n                client_params[key] = value\\n        \\n        client = OpenAIChatCompletionClient(**client_params)\\n        self.clients.append(client)  # 记录用于清理\\n        return client\\n    \\n    def _create_agent(self, agent_config: Dict[str, Any]) -> AssistantAgent:\\n        \\\"\\\"\\\"创建单个Agent - 严格按照本地知识库规范\\\"\\\"\\\"\\n        name = agent_config.get('name', 'Assistant')\\n        system_message = agent_config.get('system_message', 'You are a helpful assistant.')\\n        \\n        # 创建模型客户端\\n        model_client_config = agent_config.get('model_client', {})\\n        model_client = self._create_model_client(model_client_config)\\n        \\n        # 创建Agent\\n        agent = AssistantAgent(\\n            name=name,\\n            model_client=model_client,\\n            system_message=system_message\\n        )\\n        \\n        if self.verbose:\\n            print(f\\\"[Agent] 创建成功: {name}\\\")\\n        \\n        return agent\\n    \\n    def _create_component(self):\\n        \\\"\\\"\\\"创建组件 - Agent或Team\\\"\\\"\\\"\\n        try:\\n            if self.component_type == 'agent':\\n                self._create_agent_component()\\n            elif self.component_type == 'team':\\n                self._create_team_component()\\n            else:\\n                raise ValueError(f\\\"不支持的组件类型: {self.component_type}\\\")\\n                \\n        except Exception as e:\\n            raise RuntimeError(f\\\"创建组件失败: {e}\\\")\\n    \\n    def _create_agent_component(self):\\n        \\\"\\\"\\\"创建Agent组件\\\"\\\"\\\"\\n        # 提取Agent配置\\n        if 'config' in self.config:\\n            agent_config = self.config['config']\\n        else:\\n            agent_config = self.config\\n        \\n        self.agent = self._create_agent(agent_config)\\n        \\n        if self.verbose:\\n            print(f\\\"[组件] Agent组件创建成功\\\")\\n    \\n    def _create_team_component(self):\\n        \\\"\\\"\\\"创建Team组件 - 严格按照本地知识库规范\\\"\\\"\\\"\\n        team_config = self.config.get('config', {})\\n        participants_config = team_config.get('participants', [])\\n        \\n        if not participants_config:\\n            raise ValueError(\\\"Team配置中缺少participants\\\")\\n        \\n        # 创建所有参与者\\n        participants = []\\n        for participant_config in participants_config:\\n            if participant_config.get('component_type') == 'agent':\\n                agent_config = participant_config.get('config', {})\\n                agent = self._create_agent(agent_config)\\n                participants.append(agent)\\n            else:\\n                raise ValueError(f\\\"不支持的参与者类型: {participant_config.get('component_type')}\\\")\\n        \\n        # 创建Team - 严格按照本地知识库规范\\n        # 参照: samples/agentchat_chainlit/app_team.py\\n        team_params = {\\n            'participants': participants\\n        }\\n        \\n        # 添加其他Team配置\\n        max_turns = team_config.get('max_turns')\\n        if max_turns is not None:\\n            team_params['max_turns'] = max_turns\\n        \\n        # 创建RoundRobinGroupChat\\n        self.team = RoundRobinGroupChat(**team_params)\\n        \\n        if self.verbose:\\n            print(f\\\"[组件] Team组件创建成功，参与者数量: {len(participants)}\\\")\\n    \\n    async def run_once_async(self, user_input: str) -> str:\\n        \\\"\\\"\\\"异步执行一次推理 - 使用AutoGen原生方法\\\"\\\"\\\"\\n        try:\\n            if self.verbose:\\n                print(f\\\"\\\\n[用户] {user_input}\\\")\\n            \\n            result_messages = []\\n            \\n            if self.component_type == 'agent':\\n                # Agent模式 - 严格按照本地知识库规范\\n                async for message in self.agent.run_stream(task=user_input):\\n                    if hasattr(message, 'content'):\\n                        result_messages.append(str(message.content))\\n                    else:\\n                        result_messages.append(str(message))\\n            \\n            elif self.component_type == 'team':\\n                # Team模式 - 严格按照本地知识库规范\\n                # 参照: samples/agentchat_chainlit/app_team.py\\n                task_message = TextMessage(content=user_input, source=\\\"user\\\")\\n                \\n                async for message in self.team.run_stream(task=[task_message]):\\n                    if hasattr(message, 'content'):\\n                        result_messages.append(str(message.content))\\n                    else:\\n                        result_messages.append(str(message))\\n            \\n            # 合并所有输出\\n            result = '\\\\n'.join(result_messages) if result_messages else \\\"响应为空\\\"\\n            \\n            if self.verbose:\\n                print(f\\\"[响应] {result}\\\")\\n            \\n            return result\\n            \\n        except Exception as e:\\n            error_msg = f\\\"推理执行错误: {e}\\\"\\n            if self.verbose:\\n                print(f\\\"[错误] {error_msg}\\\")\\n                print(traceback.format_exc())\\n            return f\\\"执行出错: {error_msg}\\\"\\n    \\n    def run_once(self, user_input: str) -> str:\\n        \\\"\\\"\\\"同步执行一次推理\\\"\\\"\\\"\\n        try:\\n            return asyncio.run(self.run_once_async(user_input))\\n        except RuntimeError:\\n            # 处理事件循环冲突\\n            loop = asyncio.new_event_loop()\\n            try:\\n                return loop.run_until_complete(self.run_once_async(user_input))\\n            finally:\\n                loop.close()\\n    \\n    async def interactive_mode_async(self):\\n        \\\"\\\"\\\"异步交互模式 - 严格按照本地知识库规范\\\"\\\"\\\"\\n        component_name = \\\"智能体\\\"\\n        if self.component_type == 'agent' and self.agent:\\n            component_name = self.agent.name\\n        elif self.component_type == 'team':\\n            component_name = \\\"团队\\\"\\n        \\n        print(f\\\"开始与 {component_name} 的交互对话，输入 '退出' 结束对话\\\")\\n        \\n        round_count = 0\\n        while True:\\n            round_count += 1\\n            try:\\n                user_input = input(f\\\"\\\\n[第{round_count}轮] 用户: \\\")\\n                if user_input.lower() in (\\\"退出\\\", \\\"exit\\\", \\\"quit\\\", \\\":quit\\\"):\\n                    print(\\\"对话已结束。\\\")\\n                    break\\n                \\n                print(\\\"思考中...\\\")\\n                \\n                if self.component_type == 'agent':\\n                    # Agent交互模式\\n                    await Console(self.agent.run_stream(task=user_input))\\n                elif self.component_type == 'team':\\n                    # Team交互模式 - 严格按照本地知识库规范\\n                    task_message = TextMessage(content=user_input, source=\\\"user\\\")\\n                    await Console(self.team.run_stream(task=[task_message]))\\n                \\n            except KeyboardInterrupt:\\n                print(\\\"\\\\n对话被用户中断。\\\")\\n                break\\n            except Exception as e:\\n                print(f\\\"[错误] 对话轮次 {round_count} 出现错误: {e}\\\")\\n                if self.verbose:\\n                    print(traceback.format_exc())\\n    \\n    def interactive_mode(self):\\n        \\\"\\\"\\\"交互模式\\\"\\\"\\\"\\n        try:\\n            asyncio.run(self.interactive_mode_async())\\n        except RuntimeError:\\n            loop = asyncio.new_event_loop()\\n            try:\\n                loop.run_until_complete(self.interactive_mode_async())\\n            finally:\\n                loop.close()\\n    \\n    async def cleanup(self):\\n        \\\"\\\"\\\"清理资源 - 严格按照本地知识库规范\\\"\\\"\\\"\\n        for client in self.clients:\\n            try:\\n                await client.close()\\n                if self.verbose:\\n                    print(\\\"[清理] 模型客户端已关闭\\\")\\n            except Exception as e:\\n                if self.verbose:\\n                    print(f\\\"[警告] 清理资源时出错: {e}\\\")\\n\\ndef main():\\n    \\\"\\\"\\\"主函数\\\"\\\"\\\"\\n    parser = argparse.ArgumentParser(\\n        description=\\\"通用智能体运行脚本（AutoGen 0.7.1原生方法，支持Agent和Team）\\\",\\n        formatter_class=argparse.RawDescriptionHelpFormatter\\n    )\\n    parser.add_argument(\\\"-c\\\", \\\"--config\\\", required=True, help=\\\"智能体/团队配置文件路径\\\")\\n    parser.add_argument(\\\"-i\\\", \\\"--input\\\", help=\\\"用户输入内容（非交互模式）\\\")\\n    parser.add_argument(\\\"--interactive\\\", action=\\\"store_true\\\", help=\\\"启用交互式对话模式\\\")\\n    parser.add_argument(\\\"-v\\\", \\\"--verbose\\\", action=\\\"store_true\\\", help=\\\"详细输出模式\\\")\\n    \\n    args = parser.parse_args()\\n    \\n    runner = None\\n    try:\\n        # 创建运行器\\n        runner = UniversalRunner(args.config, verbose=args.verbose)\\n        \\n        # 选择运行模式\\n        if args.interactive:\\n            runner.interactive_mode()\\n        elif args.input:\\n            response = runner.run_once(args.input)\\n            if not args.verbose:\\n                print(response)\\n        else:\\n            parser.print_help()\\n            \\n    except Exception as e:\\n        print(f\\\"错误: {e}\\\")\\n        if args.verbose:\\n            print(traceback.format_exc())\\n        sys.exit(1)\\n    finally:\\n        # 清理资源\\n        if runner and runner.clients:\\n            try:\\n                asyncio.run(runner.cleanup())\\n            except:\\n                pass\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\",\n          \"data\": {\n            \"content\": \"设计说是的，这个脚本已经完全兼容Agent和Team！\\n\\n✅ 自动识别: 根据component_type字段自动识别\\n✅ 统一接口: 相同的命令行参数和API接口\\n✅ 原生支持: 严格使用AutoGen 0.7.1原生方法\\n✅ 测试验证: Agent和Team都测试成功\\n✅ 笔记栏集成: 后端API透明支持两种类型\\n一个脚本，两种模式，完全兼容！🚀明...\\n\\n---\\n\\n### 通用脚本\\n2025-09-19 17:21:00\\n\\n# -*- coding: utf-8 -*-\\n\\\"\\\"\\\"\\n通用智能体运行脚本 - 严格遵循AutoGen 0.7.1本地知识库规范\\n支持Agent和Team配置\\n参照: autogen_repo/python/samples/agentchat_chainlit/app_team.py\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport json\\nimport os\\nimport sys\\nimport traceback\\nimport io\\nimport asyncio\\nfrom pathlib import Path\\nfrom typing import Dict, Any, Optional, List\\n\\n# 设置UTF-8输出\\nsys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')\\n\\n# 项目根目录\\nROOT = Path(__file__).resolve().parent\\nif str(ROOT) not in sys.path:\\n    sys.path.insert(0, str(ROOT))\\n\\n# 自动加载.env文件\\ndef load_env_file():\\n    env_file = ROOT / \\\".env\\\"\\n    if env_file.exists():\\n        try:\\n            with open(env_file, 'r', encoding='utf-8') as f:\\n                for line in f:\\n                    line = line.strip()\\n                    if line and not line.startswith('#') and '=' in line:\\n                        key, value = line.split('=', 1)\\n                        key = key.strip()\\n                        value = value.strip().strip('\\\"').strip(\\\"'\\\")\\n                        if key and not os.environ.get(key):\\n                            os.environ[key] = value\\n        except Exception as e:\\n            print(f\\\"[警告] .env文件加载失败: {e}\\\")\\n\\n# 加载环境变量\\nload_env_file()\\n\\n# 导入AutoGen 0.7.1原生模块 - 严格按照本地知识库规范\\ntry:\\n    from autogen_agentchat.agents import AssistantAgent\\n    from autogen_agentchat.teams import RoundRobinGroupChat\\n    from autogen_agentchat.ui import Console\\n    from autogen_agentchat.messages import TextMessage\\n    from autogen_ext.models.openai import OpenAIChatCompletionClient\\n    print(\\\"[导入] 使用AutoGen 0.7.1原生模块\\\")\\nexcept ImportError as e:\\n    print(f\\\"错误: 无法导入AutoGen原生模块: {e}\\\")\\n    print(\\\"请确保已安装AutoGen 0.7.1:\\\")\\n    print(\\\"  pip install autogen-agentchat autogen-ext\\\")\\n    sys.exit(1)\\n\\nclass UniversalRunner:\\n    \\\"\\\"\\\"通用运行器 - 支持Agent和Team - 严格遵循本地知识库规范\\\"\\\"\\\"\\n    \\n    def __init__(self, config_path: str, verbose: bool = False):\\n        self.config_path = Path(config_path)\\n        self.verbose = verbose\\n        self.config = None\\n        self.component_type = None\\n        self.agent = None\\n        self.team = None\\n        self.clients = []  # 存储所有model clients用于清理\\n        \\n        self._load_config()\\n        self._create_component()\\n    \\n    def _load_config(self):\\n        \\\"\\\"\\\"加载配置文件\\\"\\\"\\\"\\n        if not self.config_path.exists():\\n            raise FileNotFoundError(f\\\"配置文件不存在: {self.config_path}\\\")\\n        \\n        try:\\n            with self.config_path.open('r', encoding='utf-8') as f:\\n                self.config = json.load(f)\\n            \\n            self.component_type = self.config.get('component_type', 'agent')\\n            \\n            if self.verbose:\\n                print(f\\\"[配置] 已加载: {self.config_path}\\\")\\n                print(f\\\"[配置] 组件类型: {self.component_type}\\\")\\n                \\n        except Exception as e:\\n            raise ValueError(f\\\"配置文件格式错误: {e}\\\")\\n    \\n    def _create_model_client(self, model_config: Dict[str, Any]) -> OpenAIChatCompletionClient:\\n        \\\"\\\"\\\"创建模型客户端 - 严格按照本地知识库规范\\\"\\\"\\\"\\n        mc_config = model_config.get('config', {})\\n        \\n        model = mc_config.get('model', 'gpt-3.5-turbo')\\n        base_url = mc_config.get('base_url')\\n        api_key_env = mc_config.get('api_key_env', 'OPENAI_API_KEY')\\n        \\n        # 获取API密钥\\n        api_key = os.getenv(api_key_env)\\n        if not api_key:\\n            raise ValueError(f\\\"环境变量 {api_key_env} 未设置\\\")\\n        \\n        if self.verbose:\\n            print(f\\\"[模型] 模型: {model}\\\")\\n            print(f\\\"[模型] API地址: {base_url}\\\")\\n            print(f\\\"[模型] API密钥环境变量: {api_key_env}\\\")\\n        \\n        # 构建客户端参数\\n        client_params = {\\n            'model': model,\\n            'api_key': api_key\\n        }\\n        \\n        if base_url:\\n            client_params['base_url'] = base_url\\n        \\n        # 添加其他配置参数\\n        for key, value in mc_config.items():\\n            if key not in ['model', 'base_url', 'api_key', 'api_key_env']:\\n                client_params[key] = value\\n        \\n        client = OpenAIChatCompletionClient(**client_params)\\n        self.clients.append(client)  # 记录用于清理\\n        return client\\n    \\n    def _create_agent(self, agent_config: Dict[str, Any]) -> AssistantAgent:\\n        \\\"\\\"\\\"创建单个Agent - 严格按照本地知识库规范\\\"\\\"\\\"\\n        name = agent_config.get('name', 'Assistant')\\n        system_message = agent_config.get('system_message', 'You are a helpful assistant.')\\n        \\n        # 创建模型客户端\\n        model_client_config = agent_config.get('model_client', {})\\n        model_client = self._create_model_client(model_client_config)\\n        \\n        # 创建Agent\\n        agent = AssistantAgent(\\n            name=name,\\n            model_client=model_client,\\n            system_message=system_message\\n        )\\n        \\n        if self.verbose:\\n            print(f\\\"[Agent] 创建成功: {name}\\\")\\n        \\n        return agent\\n    \\n    def _create_component(self):\\n        \\\"\\\"\\\"创建组件 - Agent或Team\\\"\\\"\\\"\\n        try:\\n            if self.component_type == 'agent':\\n                self._create_agent_component()\\n            elif self.component_type == 'team':\\n                self._create_team_component()\\n            else:\\n                raise ValueError(f\\\"不支持的组件类型: {self.component_type}\\\")\\n                \\n        except Exception as e:\\n            raise RuntimeError(f\\\"创建组件失败: {e}\\\")\\n    \\n    def _create_agent_component(self):\\n        \\\"\\\"\\\"创建Agent组件\\\"\\\"\\\"\\n        # 提取Agent配置\\n        if 'config' in self.config:\\n            agent_config = self.config['config']\\n        else:\\n            agent_config = self.config\\n        \\n        self.agent = self._create_agent(agent_config)\\n        \\n        if self.verbose:\\n            print(f\\\"[组件] Agent组件创建成功\\\")\\n    \\n    def _create_team_component(self):\\n        \\\"\\\"\\\"创建Team组件 - 严格按照本地知识库规范\\\"\\\"\\\"\\n        team_config = self.config.get('config', {})\\n        participants_config = team_config.get('participants', [])\\n        \\n        if not participants_config:\\n            raise ValueError(\\\"Team配置中缺少participants\\\")\\n        \\n        # 创建所有参与者\\n        participants = []\\n        for participant_config in participants_config:\\n            if participant_config.get('component_type') == 'agent':\\n                agent_config = participant_config.get('config', {})\\n                agent = self._create_agent(agent_config)\\n                participants.append(agent)\\n            else:\\n                raise ValueError(f\\\"不支持的参与者类型: {participant_config.get('component_type')}\\\")\\n        \\n        # 创建Team - 严格按照本地知识库规范\\n        # 参照: samples/agentchat_chainlit/app_team.py\\n        team_params = {\\n            'participants': participants\\n        }\\n        \\n        # 添加其他Team配置\\n        max_turns = team_config.get('max_turns')\\n        if max_turns is not None:\\n            team_params['max_turns'] = max_turns\\n        \\n        # 创建RoundRobinGroupChat\\n        self.team = RoundRobinGroupChat(**team_params)\\n        \\n        if self.verbose:\\n            print(f\\\"[组件] Team组件创建成功，参与者数量: {len(participants)}\\\")\\n    \\n    async def run_once_async(self, user_input: str) -> str:\\n        \\\"\\\"\\\"异步执行一次推理 - 使用AutoGen原生方法\\\"\\\"\\\"\\n        try:\\n            if self.verbose:\\n                print(f\\\"\\\\n[用户] {user_input}\\\")\\n            \\n            result_messages = []\\n            \\n            if self.component_type == 'agent':\\n                # Agent模式 - 严格按照本地知识库规范\\n                async for message in self.agent.run_stream(task=user_input):\\n                    if hasattr(message, 'content'):\\n                        result_messages.append(str(message.content))\\n                    else:\\n                        result_messages.append(str(message))\\n            \\n            elif self.component_type == 'team':\\n                # Team模式 - 严格按照本地知识库规范\\n                # 参照: samples/agentchat_chainlit/app_team.py\\n                task_message = TextMessage(content=user_input, source=\\\"user\\\")\\n                \\n                async for message in self.team.run_stream(task=[task_message]):\\n                    if hasattr(message, 'content'):\\n                        result_messages.append(str(message.content))\\n                    else:\\n                        result_messages.append(str(message))\\n            \\n            # 合并所有输出\\n            result = '\\\\n'.join(result_messages) if result_messages else \\\"响应为空\\\"\\n            \\n            if self.verbose:\\n                print(f\\\"[响应] {result}\\\")\\n            \\n            return result\\n            \\n        except Exception as e:\\n            error_msg = f\\\"推理执行错误: {e}\\\"\\n            if self.verbose:\\n                print(f\\\"[错误] {error_msg}\\\")\\n                print(traceback.format_exc())\\n            return f\\\"执行出错: {error_msg}\\\"\\n    \\n    def run_once(self, user_input: str) -> str:\\n        \\\"\\\"\\\"同步执行一次推理\\\"\\\"\\\"\\n        try:\\n            return asyncio.run(self.run_once_async(user_input))\\n        except RuntimeError:\\n            # 处理事件循环冲突\\n            loop = asyncio.new_event_loop()\\n            try:\\n                return loop.run_until_complete(self.run_once_async(user_input))\\n            finally:\\n                loop.close()\\n    \\n    async def interactive_mode_async(self):\\n        \\\"\\\"\\\"异步交互模式 - 严格按照本地知识库规范\\\"\\\"\\\"\\n        component_name = \\\"智能体\\\"\\n        if self.component_type == 'agent' and self.agent:\\n            component_name = self.agent.name\\n        elif self.component_type == 'team':\\n            component_name = \\\"团队\\\"\\n        \\n        print(f\\\"开始与 {component_name} 的交互对话，输入 '退出' 结束对话\\\")\\n        \\n        round_count = 0\\n        while True:\\n            round_count += 1\\n            try:\\n                user_input = input(f\\\"\\\\n[第{round_count}轮] 用户: \\\")\\n                if user_input.lower() in (\\\"退出\\\", \\\"exit\\\", \\\"quit\\\", \\\":quit\\\"):\\n                    print(\\\"对话已结束。\\\")\\n                    break\\n                \\n                print(\\\"思考中...\\\")\\n                \\n                if self.component_type == 'agent':\\n                    # Agent交互模式\\n                    await Console(self.agent.run_stream(task=user_input))\\n                elif self.component_type == 'team':\\n                    # Team交互模式 - 严格按照本地知识库规范\\n                    task_message = TextMessage(content=user_input, source=\\\"user\\\")\\n                    await Console(self.team.run_stream(task=[task_message]))\\n                \\n            except KeyboardInterrupt:\\n                print(\\\"\\\\n对话被用户中断。\\\")\\n                break\\n            except Exception as e:\\n                print(f\\\"[错误] 对话轮次 {round_count} 出现错误: {e}\\\")\\n                if self.verbose:\\n                    print(traceback.format_exc())\\n    \\n    def interactive_mode(self):\\n        \\\"\\\"\\\"交互模式\\\"\\\"\\\"\\n        try:\\n            asyncio.run(self.interactive_mode_async())\\n        except RuntimeError:\\n            loop = asyncio.new_event_loop()\\n            try:\\n                loop.run_until_complete(self.interactive_mode_async())\\n            finally:\\n                loop.close()\\n    \\n    async def cleanup(self):\\n        \\\"\\\"\\\"清理资源 - 严格按照本地知识库规范\\\"\\\"\\\"\\n        for client in self.clients:\\n            try:\\n                await client.close()\\n                if self.verbose:\\n                    print(\\\"[清理] 模型客户端已关闭\\\")\\n            except Exception as e:\\n                if self.verbose:\\n                    print(f\\\"[警告] 清理资源时出错: {e}\\\")\\n\\ndef main():\\n    \\\"\\\"\\\"主函数\\\"\\\"\\\"\\n    parser = argparse.ArgumentParser(\\n        description=\\\"通用智能体运行脚本（AutoGen 0.7.1原生方法，支持Agent和Team）\\\",\\n        formatter_class=argparse.RawDescriptionHelpFormatter\\n    )\\n    parser.add_argument(\\\"-c\\\", \\\"--config\\\", required=True, help=\\\"智能体/团队配置文件路径\\\")\\n    parser.add_argument(\\\"-i\\\", \\\"--input\\\", help=\\\"用户输入内容（非交互模式）\\\")\\n    parser.add_argument(\\\"--interactive\\\", action=\\\"store_true\\\", help=\\\"启用交互式对话模式\\\")\\n    parser.add_argument(\\\"-v\\\", \\\"--verbose\\\", action=\\\"store_true\\\", help=\\\"详细输出模式\\\")\\n    \\n    args = parser.parse_args()\\n    \\n    runner = None\\n    try:\\n        # 创建运行器\\n        runner = UniversalRunner(args.config, verbose=args.verbose)\\n        \\n        # 选择运行模式\\n        if args.interactive:\\n            runner.interactive_mode()\\n        elif args.input:\\n            response = runner.run_once(args.input)\\n            if not args.verbose:\\n                print(response)\\n        else:\\n            parser.print_help()\\n            \\n    except Exception as e:\\n        print(f\\\"错误: {e}\\\")\\n        if args.verbose:\\n            print(traceback.format_exc())\\n        sys.exit(1)\\n    finally:\\n        # 清理资源\\n        if runner and runner.clients:\\n            try:\\n                asyncio.run(runner.cleanup())\\n            except:\\n                pass\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"\n          },\n          \"background-color\": \"#f5f5f5\",\n          \"foreground-color\": \"#333\"\n        }\n      ]\n    }\n  ]\n}\n```\n\n---\n*自动保存于 2025/9/19 17:28:48*\n","project":{"id":"root-1758268230907-7vq1","name":"笔记页面","data":{"id":"root-1758268230907-7vq1","topic":"笔记页面","expanded":true,"content":"作为标准组件的开发标准\n","data":{"content":"作为标准组件的开发标准\n"},"background-color":"#f5f5f5","foreground-color":"#333","children":[{"id":"n3","topic":"输入框","expanded":true,"direction":"right","content":"开发计划...","data":{"content":"开发计划..."},"background-color":"#f5f5f5","foreground-color":"#333","children":[{"id":"96148c927773fa60","topic":"回车发送","expanded":true,"content":"创建: 2025-09-19 17:23:18\n\n","data":{"content":"创建: 2025-09-19 17:23:18\n\n"},"background-color":"#f5f5f5","foreground-color":"#333"},{"id":"node-1758273940397-irt0","topic":"alt + 回车发送给智能体","expanded":true,"content":"创建: 2025-09-19 17:25:40\n\n","data":{"content":"创建: 2025-09-19 17:25:40\n\n"},"background-color":"#f5f5f5","foreground-color":"#333"},{"id":"9614be1d3b1d0ab4","topic":"shift + 回车：直接记入笔记","expanded":true,"content":"创建: 2025-09-19 17:26:46\n\n","data":{"content":"创建: 2025-09-19 17:26:46\n\n"},"background-color":"#f5f5f5","foreground-color":"#333"}]},{"id":"9614cc3bbbce331a","topic":"输入按键","expanded":true,"direction":"right","content":"创建: 2025-09-19 17:27:43\n\n","children":[{"id":"9614ce737e91a66a","topic":"添加附件","expanded":true,"content":"创建: 2025-09-19 17:27:42\n\n","data":{"content":"创建: 2025-09-19 17:27:42\n\n"}}],"data":{"content":"创建: 2025-09-19 17:27:43\n\n"}},{"id":"961490aa0661846b","topic":"输出框","expanded":true,"direction":"right","content":"创建: 2025-09-19 17:23:34\n\n","data":{"content":"创建: 2025-09-19 17:23:34\n\n"},"background-color":"#f5f5f5","foreground-color":"#333","children":[{"id":"9614d2d9126e6e8e","topic":"MD阅读器","expanded":true,"content":"创建: 2025-09-19 17:28:48\n\n","data":{"content":"创建: 2025-09-19 17:28:48\n\n"}},{"id":"9614d4d4d4cb8910","topic":"笔记内容标题栏右侧（添加”复制“按键","expanded":true,"content":"创建: 2025-09-19 17:28:27\n全部复制输出框内的内容到剪贴板\n","data":{"content":"创建: 2025-09-19 17:28:27\n全部复制输出框内的内容到剪贴板\n"}}]},{"id":"961496e1a6786f4e","topic":"智能体","expanded":true,"direction":"right","content":"创建: 2025-09-19 17:23:50\n\n","data":{"content":"创建: 2025-09-19 17:23:50\n\n"},"background-color":"#f5f5f5","foreground-color":"#333","children":[{"id":"node-1758273834249-2m7v","topic":"通用脚本","expanded":true,"content":"设计说是的，这个脚本已经完全兼容Agent和Team！\n\n✅ 自动识别: 根据component_type字段自动识别\n✅ 统一接口: 相同的命令行参数和API接口\n✅ 原生支持: 严格使用AutoGen 0.7.1原生方法\n✅ 测试验证: Agent和Team都测试成功\n✅ 笔记栏集成: 后端API透明支持两种类型\n一个脚本，两种模式，完全兼容！🚀明...\n\n---\n\n### 通用脚本\n2025-09-19 17:21:00\n\n# -*- coding: utf-8 -*-\n\"\"\"\n通用智能体运行脚本 - 严格遵循AutoGen 0.7.1本地知识库规范\n支持Agent和Team配置\n参照: autogen_repo/python/samples/agentchat_chainlit/app_team.py\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport sys\nimport traceback\nimport io\nimport asyncio\nfrom pathlib import Path\nfrom typing import Dict, Any, Optional, List\n\n# 设置UTF-8输出\nsys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')\n\n# 项目根目录\nROOT = Path(__file__).resolve().parent\nif str(ROOT) not in sys.path:\n    sys.path.insert(0, str(ROOT))\n\n# 自动加载.env文件\ndef load_env_file():\n    env_file = ROOT / \".env\"\n    if env_file.exists():\n        try:\n            with open(env_file, 'r', encoding='utf-8') as f:\n                for line in f:\n                    line = line.strip()\n                    if line and not line.startswith('#') and '=' in line:\n                        key, value = line.split('=', 1)\n                        key = key.strip()\n                        value = value.strip().strip('\"').strip(\"'\")\n                        if key and not os.environ.get(key):\n                            os.environ[key] = value\n        except Exception as e:\n            print(f\"[警告] .env文件加载失败: {e}\")\n\n# 加载环境变量\nload_env_file()\n\n# 导入AutoGen 0.7.1原生模块 - 严格按照本地知识库规范\ntry:\n    from autogen_agentchat.agents import AssistantAgent\n    from autogen_agentchat.teams import RoundRobinGroupChat\n    from autogen_agentchat.ui import Console\n    from autogen_agentchat.messages import TextMessage\n    from autogen_ext.models.openai import OpenAIChatCompletionClient\n    print(\"[导入] 使用AutoGen 0.7.1原生模块\")\nexcept ImportError as e:\n    print(f\"错误: 无法导入AutoGen原生模块: {e}\")\n    print(\"请确保已安装AutoGen 0.7.1:\")\n    print(\"  pip install autogen-agentchat autogen-ext\")\n    sys.exit(1)\n\nclass UniversalRunner:\n    \"\"\"通用运行器 - 支持Agent和Team - 严格遵循本地知识库规范\"\"\"\n    \n    def __init__(self, config_path: str, verbose: bool = False):\n        self.config_path = Path(config_path)\n        self.verbose = verbose\n        self.config = None\n        self.component_type = None\n        self.agent = None\n        self.team = None\n        self.clients = []  # 存储所有model clients用于清理\n        \n        self._load_config()\n        self._create_component()\n    \n    def _load_config(self):\n        \"\"\"加载配置文件\"\"\"\n        if not self.config_path.exists():\n            raise FileNotFoundError(f\"配置文件不存在: {self.config_path}\")\n        \n        try:\n            with self.config_path.open('r', encoding='utf-8') as f:\n                self.config = json.load(f)\n            \n            self.component_type = self.config.get('component_type', 'agent')\n            \n            if self.verbose:\n                print(f\"[配置] 已加载: {self.config_path}\")\n                print(f\"[配置] 组件类型: {self.component_type}\")\n                \n        except Exception as e:\n            raise ValueError(f\"配置文件格式错误: {e}\")\n    \n    def _create_model_client(self, model_config: Dict[str, Any]) -> OpenAIChatCompletionClient:\n        \"\"\"创建模型客户端 - 严格按照本地知识库规范\"\"\"\n        mc_config = model_config.get('config', {})\n        \n        model = mc_config.get('model', 'gpt-3.5-turbo')\n        base_url = mc_config.get('base_url')\n        api_key_env = mc_config.get('api_key_env', 'OPENAI_API_KEY')\n        \n        # 获取API密钥\n        api_key = os.getenv(api_key_env)\n        if not api_key:\n            raise ValueError(f\"环境变量 {api_key_env} 未设置\")\n        \n        if self.verbose:\n            print(f\"[模型] 模型: {model}\")\n            print(f\"[模型] API地址: {base_url}\")\n            print(f\"[模型] API密钥环境变量: {api_key_env}\")\n        \n        # 构建客户端参数\n        client_params = {\n            'model': model,\n            'api_key': api_key\n        }\n        \n        if base_url:\n            client_params['base_url'] = base_url\n        \n        # 添加其他配置参数\n        for key, value in mc_config.items():\n            if key not in ['model', 'base_url', 'api_key', 'api_key_env']:\n                client_params[key] = value\n        \n        client = OpenAIChatCompletionClient(**client_params)\n        self.clients.append(client)  # 记录用于清理\n        return client\n    \n    def _create_agent(self, agent_config: Dict[str, Any]) -> AssistantAgent:\n        \"\"\"创建单个Agent - 严格按照本地知识库规范\"\"\"\n        name = agent_config.get('name', 'Assistant')\n        system_message = agent_config.get('system_message', 'You are a helpful assistant.')\n        \n        # 创建模型客户端\n        model_client_config = agent_config.get('model_client', {})\n        model_client = self._create_model_client(model_client_config)\n        \n        # 创建Agent\n        agent = AssistantAgent(\n            name=name,\n            model_client=model_client,\n            system_message=system_message\n        )\n        \n        if self.verbose:\n            print(f\"[Agent] 创建成功: {name}\")\n        \n        return agent\n    \n    def _create_component(self):\n        \"\"\"创建组件 - Agent或Team\"\"\"\n        try:\n            if self.component_type == 'agent':\n                self._create_agent_component()\n            elif self.component_type == 'team':\n                self._create_team_component()\n            else:\n                raise ValueError(f\"不支持的组件类型: {self.component_type}\")\n                \n        except Exception as e:\n            raise RuntimeError(f\"创建组件失败: {e}\")\n    \n    def _create_agent_component(self):\n        \"\"\"创建Agent组件\"\"\"\n        # 提取Agent配置\n        if 'config' in self.config:\n            agent_config = self.config['config']\n        else:\n            agent_config = self.config\n        \n        self.agent = self._create_agent(agent_config)\n        \n        if self.verbose:\n            print(f\"[组件] Agent组件创建成功\")\n    \n    def _create_team_component(self):\n        \"\"\"创建Team组件 - 严格按照本地知识库规范\"\"\"\n        team_config = self.config.get('config', {})\n        participants_config = team_config.get('participants', [])\n        \n        if not participants_config:\n            raise ValueError(\"Team配置中缺少participants\")\n        \n        # 创建所有参与者\n        participants = []\n        for participant_config in participants_config:\n            if participant_config.get('component_type') == 'agent':\n                agent_config = participant_config.get('config', {})\n                agent = self._create_agent(agent_config)\n                participants.append(agent)\n            else:\n                raise ValueError(f\"不支持的参与者类型: {participant_config.get('component_type')}\")\n        \n        # 创建Team - 严格按照本地知识库规范\n        # 参照: samples/agentchat_chainlit/app_team.py\n        team_params = {\n            'participants': participants\n        }\n        \n        # 添加其他Team配置\n        max_turns = team_config.get('max_turns')\n        if max_turns is not None:\n            team_params['max_turns'] = max_turns\n        \n        # 创建RoundRobinGroupChat\n        self.team = RoundRobinGroupChat(**team_params)\n        \n        if self.verbose:\n            print(f\"[组件] Team组件创建成功，参与者数量: {len(participants)}\")\n    \n    async def run_once_async(self, user_input: str) -> str:\n        \"\"\"异步执行一次推理 - 使用AutoGen原生方法\"\"\"\n        try:\n            if self.verbose:\n                print(f\"\\n[用户] {user_input}\")\n            \n            result_messages = []\n            \n            if self.component_type == 'agent':\n                # Agent模式 - 严格按照本地知识库规范\n                async for message in self.agent.run_stream(task=user_input):\n                    if hasattr(message, 'content'):\n                        result_messages.append(str(message.content))\n                    else:\n                        result_messages.append(str(message))\n            \n            elif self.component_type == 'team':\n                # Team模式 - 严格按照本地知识库规范\n                # 参照: samples/agentchat_chainlit/app_team.py\n                task_message = TextMessage(content=user_input, source=\"user\")\n                \n                async for message in self.team.run_stream(task=[task_message]):\n                    if hasattr(message, 'content'):\n                        result_messages.append(str(message.content))\n                    else:\n                        result_messages.append(str(message))\n            \n            # 合并所有输出\n            result = '\\n'.join(result_messages) if result_messages else \"响应为空\"\n            \n            if self.verbose:\n                print(f\"[响应] {result}\")\n            \n            return result\n            \n        except Exception as e:\n            error_msg = f\"推理执行错误: {e}\"\n            if self.verbose:\n                print(f\"[错误] {error_msg}\")\n                print(traceback.format_exc())\n            return f\"执行出错: {error_msg}\"\n    \n    def run_once(self, user_input: str) -> str:\n        \"\"\"同步执行一次推理\"\"\"\n        try:\n            return asyncio.run(self.run_once_async(user_input))\n        except RuntimeError:\n            # 处理事件循环冲突\n            loop = asyncio.new_event_loop()\n            try:\n                return loop.run_until_complete(self.run_once_async(user_input))\n            finally:\n                loop.close()\n    \n    async def interactive_mode_async(self):\n        \"\"\"异步交互模式 - 严格按照本地知识库规范\"\"\"\n        component_name = \"智能体\"\n        if self.component_type == 'agent' and self.agent:\n            component_name = self.agent.name\n        elif self.component_type == 'team':\n            component_name = \"团队\"\n        \n        print(f\"开始与 {component_name} 的交互对话，输入 '退出' 结束对话\")\n        \n        round_count = 0\n        while True:\n            round_count += 1\n            try:\n                user_input = input(f\"\\n[第{round_count}轮] 用户: \")\n                if user_input.lower() in (\"退出\", \"exit\", \"quit\", \":quit\"):\n                    print(\"对话已结束。\")\n                    break\n                \n                print(\"思考中...\")\n                \n                if self.component_type == 'agent':\n                    # Agent交互模式\n                    await Console(self.agent.run_stream(task=user_input))\n                elif self.component_type == 'team':\n                    # Team交互模式 - 严格按照本地知识库规范\n                    task_message = TextMessage(content=user_input, source=\"user\")\n                    await Console(self.team.run_stream(task=[task_message]))\n                \n            except KeyboardInterrupt:\n                print(\"\\n对话被用户中断。\")\n                break\n            except Exception as e:\n                print(f\"[错误] 对话轮次 {round_count} 出现错误: {e}\")\n                if self.verbose:\n                    print(traceback.format_exc())\n    \n    def interactive_mode(self):\n        \"\"\"交互模式\"\"\"\n        try:\n            asyncio.run(self.interactive_mode_async())\n        except RuntimeError:\n            loop = asyncio.new_event_loop()\n            try:\n                loop.run_until_complete(self.interactive_mode_async())\n            finally:\n                loop.close()\n    \n    async def cleanup(self):\n        \"\"\"清理资源 - 严格按照本地知识库规范\"\"\"\n        for client in self.clients:\n            try:\n                await client.close()\n                if self.verbose:\n                    print(\"[清理] 模型客户端已关闭\")\n            except Exception as e:\n                if self.verbose:\n                    print(f\"[警告] 清理资源时出错: {e}\")\n\ndef main():\n    \"\"\"主函数\"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"通用智能体运行脚本（AutoGen 0.7.1原生方法，支持Agent和Team）\",\n        formatter_class=argparse.RawDescriptionHelpFormatter\n    )\n    parser.add_argument(\"-c\", \"--config\", required=True, help=\"智能体/团队配置文件路径\")\n    parser.add_argument(\"-i\", \"--input\", help=\"用户输入内容（非交互模式）\")\n    parser.add_argument(\"--interactive\", action=\"store_true\", help=\"启用交互式对话模式\")\n    parser.add_argument(\"-v\", \"--verbose\", action=\"store_true\", help=\"详细输出模式\")\n    \n    args = parser.parse_args()\n    \n    runner = None\n    try:\n        # 创建运行器\n        runner = UniversalRunner(args.config, verbose=args.verbose)\n        \n        # 选择运行模式\n        if args.interactive:\n            runner.interactive_mode()\n        elif args.input:\n            response = runner.run_once(args.input)\n            if not args.verbose:\n                print(response)\n        else:\n            parser.print_help()\n            \n    except Exception as e:\n        print(f\"错误: {e}\")\n        if args.verbose:\n            print(traceback.format_exc())\n        sys.exit(1)\n    finally:\n        # 清理资源\n        if runner and runner.clients:\n            try:\n                asyncio.run(runner.cleanup())\n            except:\n                pass\n\nif __name__ == \"__main__\":\n    main()\n","data":{"content":"设计说是的，这个脚本已经完全兼容Agent和Team！\n\n✅ 自动识别: 根据component_type字段自动识别\n✅ 统一接口: 相同的命令行参数和API接口\n✅ 原生支持: 严格使用AutoGen 0.7.1原生方法\n✅ 测试验证: Agent和Team都测试成功\n✅ 笔记栏集成: 后端API透明支持两种类型\n一个脚本，两种模式，完全兼容！🚀明...\n\n---\n\n### 通用脚本\n2025-09-19 17:21:00\n\n# -*- coding: utf-8 -*-\n\"\"\"\n通用智能体运行脚本 - 严格遵循AutoGen 0.7.1本地知识库规范\n支持Agent和Team配置\n参照: autogen_repo/python/samples/agentchat_chainlit/app_team.py\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport sys\nimport traceback\nimport io\nimport asyncio\nfrom pathlib import Path\nfrom typing import Dict, Any, Optional, List\n\n# 设置UTF-8输出\nsys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')\n\n# 项目根目录\nROOT = Path(__file__).resolve().parent\nif str(ROOT) not in sys.path:\n    sys.path.insert(0, str(ROOT))\n\n# 自动加载.env文件\ndef load_env_file():\n    env_file = ROOT / \".env\"\n    if env_file.exists():\n        try:\n            with open(env_file, 'r', encoding='utf-8') as f:\n                for line in f:\n                    line = line.strip()\n                    if line and not line.startswith('#') and '=' in line:\n                        key, value = line.split('=', 1)\n                        key = key.strip()\n                        value = value.strip().strip('\"').strip(\"'\")\n                        if key and not os.environ.get(key):\n                            os.environ[key] = value\n        except Exception as e:\n            print(f\"[警告] .env文件加载失败: {e}\")\n\n# 加载环境变量\nload_env_file()\n\n# 导入AutoGen 0.7.1原生模块 - 严格按照本地知识库规范\ntry:\n    from autogen_agentchat.agents import AssistantAgent\n    from autogen_agentchat.teams import RoundRobinGroupChat\n    from autogen_agentchat.ui import Console\n    from autogen_agentchat.messages import TextMessage\n    from autogen_ext.models.openai import OpenAIChatCompletionClient\n    print(\"[导入] 使用AutoGen 0.7.1原生模块\")\nexcept ImportError as e:\n    print(f\"错误: 无法导入AutoGen原生模块: {e}\")\n    print(\"请确保已安装AutoGen 0.7.1:\")\n    print(\"  pip install autogen-agentchat autogen-ext\")\n    sys.exit(1)\n\nclass UniversalRunner:\n    \"\"\"通用运行器 - 支持Agent和Team - 严格遵循本地知识库规范\"\"\"\n    \n    def __init__(self, config_path: str, verbose: bool = False):\n        self.config_path = Path(config_path)\n        self.verbose = verbose\n        self.config = None\n        self.component_type = None\n        self.agent = None\n        self.team = None\n        self.clients = []  # 存储所有model clients用于清理\n        \n        self._load_config()\n        self._create_component()\n    \n    def _load_config(self):\n        \"\"\"加载配置文件\"\"\"\n        if not self.config_path.exists():\n            raise FileNotFoundError(f\"配置文件不存在: {self.config_path}\")\n        \n        try:\n            with self.config_path.open('r', encoding='utf-8') as f:\n                self.config = json.load(f)\n            \n            self.component_type = self.config.get('component_type', 'agent')\n            \n            if self.verbose:\n                print(f\"[配置] 已加载: {self.config_path}\")\n                print(f\"[配置] 组件类型: {self.component_type}\")\n                \n        except Exception as e:\n            raise ValueError(f\"配置文件格式错误: {e}\")\n    \n    def _create_model_client(self, model_config: Dict[str, Any]) -> OpenAIChatCompletionClient:\n        \"\"\"创建模型客户端 - 严格按照本地知识库规范\"\"\"\n        mc_config = model_config.get('config', {})\n        \n        model = mc_config.get('model', 'gpt-3.5-turbo')\n        base_url = mc_config.get('base_url')\n        api_key_env = mc_config.get('api_key_env', 'OPENAI_API_KEY')\n        \n        # 获取API密钥\n        api_key = os.getenv(api_key_env)\n        if not api_key:\n            raise ValueError(f\"环境变量 {api_key_env} 未设置\")\n        \n        if self.verbose:\n            print(f\"[模型] 模型: {model}\")\n            print(f\"[模型] API地址: {base_url}\")\n            print(f\"[模型] API密钥环境变量: {api_key_env}\")\n        \n        # 构建客户端参数\n        client_params = {\n            'model': model,\n            'api_key': api_key\n        }\n        \n        if base_url:\n            client_params['base_url'] = base_url\n        \n        # 添加其他配置参数\n        for key, value in mc_config.items():\n            if key not in ['model', 'base_url', 'api_key', 'api_key_env']:\n                client_params[key] = value\n        \n        client = OpenAIChatCompletionClient(**client_params)\n        self.clients.append(client)  # 记录用于清理\n        return client\n    \n    def _create_agent(self, agent_config: Dict[str, Any]) -> AssistantAgent:\n        \"\"\"创建单个Agent - 严格按照本地知识库规范\"\"\"\n        name = agent_config.get('name', 'Assistant')\n        system_message = agent_config.get('system_message', 'You are a helpful assistant.')\n        \n        # 创建模型客户端\n        model_client_config = agent_config.get('model_client', {})\n        model_client = self._create_model_client(model_client_config)\n        \n        # 创建Agent\n        agent = AssistantAgent(\n            name=name,\n            model_client=model_client,\n            system_message=system_message\n        )\n        \n        if self.verbose:\n            print(f\"[Agent] 创建成功: {name}\")\n        \n        return agent\n    \n    def _create_component(self):\n        \"\"\"创建组件 - Agent或Team\"\"\"\n        try:\n            if self.component_type == 'agent':\n                self._create_agent_component()\n            elif self.component_type == 'team':\n                self._create_team_component()\n            else:\n                raise ValueError(f\"不支持的组件类型: {self.component_type}\")\n                \n        except Exception as e:\n            raise RuntimeError(f\"创建组件失败: {e}\")\n    \n    def _create_agent_component(self):\n        \"\"\"创建Agent组件\"\"\"\n        # 提取Agent配置\n        if 'config' in self.config:\n            agent_config = self.config['config']\n        else:\n            agent_config = self.config\n        \n        self.agent = self._create_agent(agent_config)\n        \n        if self.verbose:\n            print(f\"[组件] Agent组件创建成功\")\n    \n    def _create_team_component(self):\n        \"\"\"创建Team组件 - 严格按照本地知识库规范\"\"\"\n        team_config = self.config.get('config', {})\n        participants_config = team_config.get('participants', [])\n        \n        if not participants_config:\n            raise ValueError(\"Team配置中缺少participants\")\n        \n        # 创建所有参与者\n        participants = []\n        for participant_config in participants_config:\n            if participant_config.get('component_type') == 'agent':\n                agent_config = participant_config.get('config', {})\n                agent = self._create_agent(agent_config)\n                participants.append(agent)\n            else:\n                raise ValueError(f\"不支持的参与者类型: {participant_config.get('component_type')}\")\n        \n        # 创建Team - 严格按照本地知识库规范\n        # 参照: samples/agentchat_chainlit/app_team.py\n        team_params = {\n            'participants': participants\n        }\n        \n        # 添加其他Team配置\n        max_turns = team_config.get('max_turns')\n        if max_turns is not None:\n            team_params['max_turns'] = max_turns\n        \n        # 创建RoundRobinGroupChat\n        self.team = RoundRobinGroupChat(**team_params)\n        \n        if self.verbose:\n            print(f\"[组件] Team组件创建成功，参与者数量: {len(participants)}\")\n    \n    async def run_once_async(self, user_input: str) -> str:\n        \"\"\"异步执行一次推理 - 使用AutoGen原生方法\"\"\"\n        try:\n            if self.verbose:\n                print(f\"\\n[用户] {user_input}\")\n            \n            result_messages = []\n            \n            if self.component_type == 'agent':\n                # Agent模式 - 严格按照本地知识库规范\n                async for message in self.agent.run_stream(task=user_input):\n                    if hasattr(message, 'content'):\n                        result_messages.append(str(message.content))\n                    else:\n                        result_messages.append(str(message))\n            \n            elif self.component_type == 'team':\n                # Team模式 - 严格按照本地知识库规范\n                # 参照: samples/agentchat_chainlit/app_team.py\n                task_message = TextMessage(content=user_input, source=\"user\")\n                \n                async for message in self.team.run_stream(task=[task_message]):\n                    if hasattr(message, 'content'):\n                        result_messages.append(str(message.content))\n                    else:\n                        result_messages.append(str(message))\n            \n            # 合并所有输出\n            result = '\\n'.join(result_messages) if result_messages else \"响应为空\"\n            \n            if self.verbose:\n                print(f\"[响应] {result}\")\n            \n            return result\n            \n        except Exception as e:\n            error_msg = f\"推理执行错误: {e}\"\n            if self.verbose:\n                print(f\"[错误] {error_msg}\")\n                print(traceback.format_exc())\n            return f\"执行出错: {error_msg}\"\n    \n    def run_once(self, user_input: str) -> str:\n        \"\"\"同步执行一次推理\"\"\"\n        try:\n            return asyncio.run(self.run_once_async(user_input))\n        except RuntimeError:\n            # 处理事件循环冲突\n            loop = asyncio.new_event_loop()\n            try:\n                return loop.run_until_complete(self.run_once_async(user_input))\n            finally:\n                loop.close()\n    \n    async def interactive_mode_async(self):\n        \"\"\"异步交互模式 - 严格按照本地知识库规范\"\"\"\n        component_name = \"智能体\"\n        if self.component_type == 'agent' and self.agent:\n            component_name = self.agent.name\n        elif self.component_type == 'team':\n            component_name = \"团队\"\n        \n        print(f\"开始与 {component_name} 的交互对话，输入 '退出' 结束对话\")\n        \n        round_count = 0\n        while True:\n            round_count += 1\n            try:\n                user_input = input(f\"\\n[第{round_count}轮] 用户: \")\n                if user_input.lower() in (\"退出\", \"exit\", \"quit\", \":quit\"):\n                    print(\"对话已结束。\")\n                    break\n                \n                print(\"思考中...\")\n                \n                if self.component_type == 'agent':\n                    # Agent交互模式\n                    await Console(self.agent.run_stream(task=user_input))\n                elif self.component_type == 'team':\n                    # Team交互模式 - 严格按照本地知识库规范\n                    task_message = TextMessage(content=user_input, source=\"user\")\n                    await Console(self.team.run_stream(task=[task_message]))\n                \n            except KeyboardInterrupt:\n                print(\"\\n对话被用户中断。\")\n                break\n            except Exception as e:\n                print(f\"[错误] 对话轮次 {round_count} 出现错误: {e}\")\n                if self.verbose:\n                    print(traceback.format_exc())\n    \n    def interactive_mode(self):\n        \"\"\"交互模式\"\"\"\n        try:\n            asyncio.run(self.interactive_mode_async())\n        except RuntimeError:\n            loop = asyncio.new_event_loop()\n            try:\n                loop.run_until_complete(self.interactive_mode_async())\n            finally:\n                loop.close()\n    \n    async def cleanup(self):\n        \"\"\"清理资源 - 严格按照本地知识库规范\"\"\"\n        for client in self.clients:\n            try:\n                await client.close()\n                if self.verbose:\n                    print(\"[清理] 模型客户端已关闭\")\n            except Exception as e:\n                if self.verbose:\n                    print(f\"[警告] 清理资源时出错: {e}\")\n\ndef main():\n    \"\"\"主函数\"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"通用智能体运行脚本（AutoGen 0.7.1原生方法，支持Agent和Team）\",\n        formatter_class=argparse.RawDescriptionHelpFormatter\n    )\n    parser.add_argument(\"-c\", \"--config\", required=True, help=\"智能体/团队配置文件路径\")\n    parser.add_argument(\"-i\", \"--input\", help=\"用户输入内容（非交互模式）\")\n    parser.add_argument(\"--interactive\", action=\"store_true\", help=\"启用交互式对话模式\")\n    parser.add_argument(\"-v\", \"--verbose\", action=\"store_true\", help=\"详细输出模式\")\n    \n    args = parser.parse_args()\n    \n    runner = None\n    try:\n        # 创建运行器\n        runner = UniversalRunner(args.config, verbose=args.verbose)\n        \n        # 选择运行模式\n        if args.interactive:\n            runner.interactive_mode()\n        elif args.input:\n            response = runner.run_once(args.input)\n            if not args.verbose:\n                print(response)\n        else:\n            parser.print_help()\n            \n    except Exception as e:\n        print(f\"错误: {e}\")\n        if args.verbose:\n            print(traceback.format_exc())\n        sys.exit(1)\n    finally:\n        # 清理资源\n        if runner and runner.clients:\n            try:\n                asyncio.run(runner.cleanup())\n            except:\n                pass\n\nif __name__ == \"__main__\":\n    main()\n"},"background-color":"#f5f5f5","foreground-color":"#333"}]}]},"format":"node_tree","updatedAt":"2025-09-19T09:28:48.997Z","timestamp":1758274128997}}